# Copy to .env and fill in. Never commit .env.
# All sample data in this project is synthetic. Do not point it at real patient data.

# Which OCR adapter to use: "cloud" or "local" (local or recorded fallback)
OCR_PROVIDER=local
# API key for the cloud OCR service (only needed when OCR_PROVIDER=cloud)
OCR_API_KEY=

# Which extraction adapter to use:
#   rules    - rule-based reader (default, works offline)
#   model    - live Gemini call (needs EXTRACT_API_KEY)
#   recorded - saved model answers from fixtures/extract/ (offline, no key, no .env needed)
EXTRACT_PROVIDER=rules
# API key for the extraction model (only needed when EXTRACT_PROVIDER=model or npm run record:live)
EXTRACT_API_KEY=
# Model name for live calls (optional; default gemini-3.8-flash)
EXTRACT_MODEL=
# Thinking level for live calls: low, medium or high (optional).
# Leave empty to send nothing and keep the model's default (medium for gemini-3.8-flash).
EXTRACT_THINKING_LEVEL=

# Seed for the synthetic fax generator, so runs are repeatable
FAX_SEED=1
