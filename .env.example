# Copy to .env and fill in. Never commit .env.
# All sample data in this project is synthetic. Do not point it at real patient data.

# Which OCR adapter to use: "cloud" or "local" (local or recorded fallback)
OCR_PROVIDER=local
# API key for the cloud OCR service (only needed when OCR_PROVIDER=cloud)
OCR_API_KEY=

# Which extraction adapter to use: "rules" (default, works offline).
# "model" and "recorded" (recorded fallback) are coming in a later step.
EXTRACT_PROVIDER=rules
# API key for the extraction model (only needed when EXTRACT_PROVIDER=model, later step)
EXTRACT_API_KEY=

# Seed for the synthetic fax generator, so runs are repeatable
FAX_SEED=1
