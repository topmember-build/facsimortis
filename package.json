{
  "name": "facsimortis",
  "version": "0.0.0",
  "private": true,
  "description": "Demo that turns synthetic faxed referrals into verified, structured records with source ghosts. Synthetic data only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "gen:faxes": "tsx src/scripts/gen-faxes.ts",
    "ocr": "tsx src/scripts/ocr.ts",
    "extract": "tsx src/scripts/extract.ts",
    "record:live": "tsx src/scripts/record-live.ts",
    "proof": "tsx src/scripts/proof.ts",
    "precompute": "tsx src/scripts/precompute.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "jsdom": "31.0.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  }
}
